/data
/logs
/tmp
# Preserve audited dependency notices despite the general markdown exclusion.
!tools/codex-transport/vendor/**/LICENSE*
!tools/codex-transport/vendor/**/NOTICE*
!tools/codex-transport/vendor/**/COPYING*
.superset
