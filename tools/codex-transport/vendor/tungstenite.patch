+/// Prepare an upgrade response and extension state for an external HTTP server.
+pub fn create_response_with_extensions<T>(request: &HttpRequest<T>, config: &WebSocketConfig) -> Result<(Response, Extensions)> {
+    let mut response = create_parts(request)?.body(())?;
+    let mut negotiated = Extensions::default();
+    if let Some(offers) = request.headers().typed_try_get::<SecWebsocketExtensions>().map_err(|_| ProtocolError::InvalidHeader(SecWebsocketExtensions::name().clone().into()))? {
+        let (extensions, agreed) = config.extensions.accept_offers(&offers).map_err(ProtocolError::from)?;
+        if let Some(agreed) = agreed { response.headers_mut().typed_insert(agreed); }
+        negotiated = extensions;
+    }
+    Ok((response, negotiated))
 }
 
